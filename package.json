{
  "name": "@devdevgg/dsh-branding-devdevgg",
  "version": "0.1.0",
  "description": "Central, slot-based branding for DeepSeek Harness deployments, with AI DEV LAB defaults and i18n-safe behavior.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.2.1-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "branding",
    "logo",
    "ai-dev-lab"
  ]
}
